{
  "name": "@weavefield/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @weavefield/database build && nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/main.js",
    "test:integration": "pnpm --filter @weavefield/api... build && node --env-file-if-exists=../../packages/database/.env test/auth.integration.cjs",
    "test:workspaces": "pnpm --filter @weavefield/api... build && node --env-file-if-exists=../../packages/database/.env test/workspaces.integration.cjs",
    "test:documents": "pnpm --filter @weavefield/api... build && node --env-file-if-exists=../../packages/database/.env test/documents.integration.cjs",
    "test:openapi": "pnpm --filter @weavefield/api... build && node --env-file-if-exists=../../packages/database/.env test/openapi.integration.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "dotenv": "^16.4.0",
    "@weavefield/database": "workspace:*",
    "express": "5.2.1",
    "@nestjs/swagger": "11.4.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "@apidevtools/swagger-parser": "13.1.0",
    "ajv": "8.20.0"
  }
}
