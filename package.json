{
  "name": "weavefield",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo dev --parallel",
    "dev:web": "pnpm --filter @weavefield/web dev",
    "dev:api": "pnpm --filter @weavefield/api dev",
    "dev:collab": "pnpm --filter @weavefield/collab dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @weavefield/database db:generate",
    "db:migrate": "pnpm --filter @weavefield/database db:migrate"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
